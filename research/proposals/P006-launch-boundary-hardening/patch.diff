index 0000000..8098b07
--- /dev/null
+++ b/tests/test_launch_boundary_regressions.py
@@ -0,0 +1,131 @@
+"""Offline launch-boundary regression tests; all broker objects are test doubles."""
+import sys
+import multiprocessing
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import replace
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from unittest.mock import patch
+
+sys.path[:0] = [str(Path(__file__).resolve().parents[1] / 'engine'), str(Path(__file__).resolve().parent)]
+import test_execution_layer as b
+from execution import durable_store
+from execution.contracts import LedgerError
+from execution.production_runtime import external_readiness_report
+
+class LaunchBoundaryTests(unittest.TestCase):
+    def test_future_health_refused(self):
+        now = datetime.now(timezone.utc)
+        evidence = b.HealthGateEvidence(True, (), (now + timedelta(days=1)).isoformat())
+        self.assertFalse(evidence.is_valid(now)[0])
+
+    def test_nonfinite_health_lifetime_refused(self):
+        now = datetime.now(timezone.utc)
+        for lifetime in (float('nan'), float('inf'), 0, -1):
+            evidence = b.HealthGateEvidence(True, (), now.isoformat(), lifetime)
+            self.assertFalse(evidence.is_valid(now)[0])
+
+    def test_future_naive_and_malformed_preflight_refused(self):
+        now = datetime.now(timezone.utc)
+        order = b.intent()
+        for stamp in ((now + timedelta(days=1)).isoformat(), now.replace(tzinfo=None).isoformat(), 'invalid'):
+            report = b.permissive_report(order, now=now)
+            report.artifacts['intent_binding']['evaluated_at'] = stamp
+            self.assertFalse(report.binding_matches(order, now=now)[0])
+
+    def test_nonfinite_preflight_lifetime_refused(self):
+        now = datetime.now(timezone.utc)
+        order = b.intent()
+        for lifetime in (float('nan'), float('inf'), 0, -1):
+            self.assertFalse(b.permissive_report(order, now=now).binding_matches(order, now=now, max_age_seconds=lifetime)[0])
+
+    def test_fresh_evidence_still_valid(self):
+        now = datetime.now(timezone.utc)
+        order = b.intent()
+        self.assertTrue(b.permissive_report(order, now=now).binding_matches(order, now=now)[0])
+        self.assertTrue(b.HealthGateEvidence(True, (), now.isoformat()).is_valid(now)[0])
+
+    def test_environment_changed_refused_before_boundary(self):
+        with b.isolated_store():
+            order = b.intent()
+            gateway, adapter = b.build_gateway(adapter=b.FakeAdapter(environment='WRONG_ENV'))
+            result = b.submit(gateway, b.permissive_report(order, now=datetime.now(timezone.utc)), order=order)
+            self.assertEqual(result.outcome, 'BROKER_STATE_CHANGED')
+            self.assertEqual(adapter.submitted, [])
+
+    def test_zero_authorized_quantity_never_becomes_unlimited(self):
+        with b.isolated_store():
+            order = b.intent()
+            gateway, adapter = b.build_gateway()
+            result = b.submit(gateway, b.permissive_report(order, now=datetime.now(timezone.utc), authorized_quantity=0), order=order)
+            self.assertEqual(result.outcome, 'REFUSED_BY_SCOPE')
+            self.assertEqual(adapter.submitted, [])
+
+    def test_locked_cancel_never_reaches_adapter(self):
+        with b.isolated_store():
+            gateway, adapter = b.build_gateway()
+            result = gateway.request_cancel(broker_order_id='test', reason='test', actor='OWNER')
+            self.assertFalse(result['cancelled'])
+            self.assertEqual(adapter.cancelled, [])
+
+    def test_missing_ledger_with_checksum_is_not_fresh_state(self):
+        with b.isolated_store():
+            durable_store.write_json('intent_ledger.json', {'schema_version': 1, 'entries': {}})
+            (durable_store.ROOT_DIR / 'intent_ledger.json').unlink()
+            with self.assertRaises(LedgerError):
+                b.IdempotencyLedger().all_entries()
+
+    def test_fresh_empty_store_is_supported(self):
+        with b.isolated_store():
+            self.assertEqual(b.IdempotencyLedger().all_entries(), {})
+
+    def test_concurrent_duplicate_submits_once(self):
+        with b.owner_key_configured(), b.isolated_store():
+            order = b.intent()
+            gateway, adapter = b.build_gateway(stage=b.Stage.LIVE_ENABLED, boundary=b.ReleasingBoundary())
+            report = b.permissive_report(order, now=datetime.now(timezone.utc))
+            def run(_):
+                return b.submit(gateway, report, order=order).outcome
+            with ThreadPoolExecutor(max_workers=8) as pool:
+                outcomes = list(pool.map(run, range(16)))
+            self.assertEqual(outcomes.count('TRANSMITTED'), 1)
+            self.assertEqual(outcomes.count('DUPLICATE_SUPPRESSED'), 15)
+            self.assertEqual(len(adapter.submitted), 1)
+
+    def test_concurrent_processes_submit_once(self):
+        with b.owner_key_configured(), b.isolated_store():
+            order = b.intent()
+            gateway, adapter = b.build_gateway(stage=b.Stage.LIVE_ENABLED, boundary=b.ReleasingBoundary())
+            report = b.permissive_report(order, now=datetime.now(timezone.utc))
+            ctx = multiprocessing.get_context('fork')
+            queue = ctx.Queue()
+            start = ctx.Event()
+            def run():
+                start.wait(5)
+                queue.put(b.submit(gateway, report, order=order).outcome)
+            workers = [ctx.Process(target=run) for _ in range(4)]
+            for worker in workers:
+                worker.start()
+            start.set()
+            try:
+                outcomes = [queue.get(timeout=10) for _ in workers]
+                self.assertEqual(outcomes.count('TRANSMITTED'), 1)
+                self.assertEqual(outcomes.count('DUPLICATE_SUPPRESSED'), 3)
+            finally:
+                for worker in workers:
+                    worker.join(10)
+                    if worker.is_alive():
+                        worker.terminate()
+                        worker.join()
+                    self.assertEqual(worker.exitcode, 0)
+
+    def test_exception_text_cannot_leak_credentials(self):
+        marker = 'PRIVATE_TEST_CREDENTIAL'
+        with patch('execution.production_runtime.collect_external_readiness_artifacts', side_effect=RuntimeError(marker)):
+            report = external_readiness_report(environ={})
+        self.assertNotIn(marker, str(report))
+        self.assertFalse(report['verified'])
+
+if __name__ == '__main__':
+    unittest.main()
