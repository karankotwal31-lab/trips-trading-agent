+@contextmanager
+def transaction():
+    """Serialize gateway submissions on one durable local filesystem.
+
+    All workers must share ROOT_DIR; this is not a distributed database lease.
+    Unsupported platforms fail closed rather than running without a lock.
+    """
+    import fcntl
+
+    ROOT_DIR.mkdir(parents=True, exist_ok=True)
+    with (ROOT_DIR / ".gateway.lock").open("a") as handle:
+        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
+
+
 def write_json(name: str, payload: Any) -> None:
     path = _safe_path(name)
     path.parent.mkdir(parents=True, exist_ok=True)
