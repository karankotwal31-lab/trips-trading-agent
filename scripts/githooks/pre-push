#!/bin/sh
# Opt-in pre-push hook: runs Trip's safety gate before anything leaves the machine.
#
# Enable once per clone:
#   git config core.hooksPath scripts/githooks
#
# Deliberately bypass-able for a genuine emergency with:
#   git push --no-verify
# A bypass is never silent: the pushed commit still has to satisfy CI or a reviewer.
set -eu

cd "$(git rev-parse --show-toplevel)"
exec sh ./scripts/verify_all.sh
